                }
              }
            },
            "url": {
              "raw": "{{express_url}}/recommend",
              "host": ["{{express_url}}"],
              "path": ["recommend"]
            },
            "description": "Test case validasi input — harus return 400."
          },
          "response": []
        },
        {
          "name": "POST /batch-recommend",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titles\": [\n    \"The Dark Knight\",\n    \"Inception\",\n    \"Interstellar\"\n  ],\n  \"top_n\": 3\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{express_url}}/batch-recommend",
              "host": ["{{express_url}}"],
              "path": ["batch-recommend"]
            },
            "description": "Forward batch request ke ML /batch-predict."
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"results\": [\n    {\n      \"input_title\": \"The Dark Knight\",\n      \"recommendations\": [...],\n      \"total\": 3\n    }\n  ],\n  \"total_processed\": 3,\n  \"timestamp\": \"2026-05-18T10:00:00.000Z\",\n  \"source\": \"express-service → python-ml-fastapi\"\n}"
            }
          ]
        },
        {
